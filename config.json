{
    "validation": {
        "minimum_observation_months": 6,
        "minimum_transactions": 30,
        "reject_on_duplicate_rrn": true,
        "reject_on_malformed_schema": true
    },
    "rules": {
        "revenue_stability": {
            "weight_if_passed": 20,
            "weight_if_failed": -20,
            "max_residual_cv": 0.25
        },
        "trend_direction": {
            "weight_if_passed": 15,
            "weight_if_failed": -15,
            "min_monthly_change": -0.05
        },
        "shock_recovery": {
            "weight_if_passed": 10,
            "weight_if_failed": -10,
            "min_recovery_ratio": 0.8,
            "max_excusable_shocks": 2
        },
        "structural_irregularity_handling": {
            "weight_if_passed": 15,
            "weight_if_failed": -15,
            "max_unexplained_gap_share": 0.10,
            "max_unexplained_longest_gap_days": 7
        }
    },
    "scoring": {
        "scale_max": 100,
        "eligible_threshold": 70,
        "review_threshold": 50
    }
}
